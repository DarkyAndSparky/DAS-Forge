{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["packages/core/src/**/*.js", "examples/workshop/**/*.js"],
  "exclude": ["**/node_modules/**", "**/test/**", "**/e2e/**"]
}
